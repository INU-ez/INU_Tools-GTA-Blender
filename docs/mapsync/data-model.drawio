        <mxCell id="RLt2" value="строка удалена" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="511" y="657" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611" y="657" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="LL" value="В IDE колонки-номера нет: на строки IDE никто не ссылается по номеру, поэтому при удалении и вставке ничего не пересчитывается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="680" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_277_8_L0" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="294.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_277_9_L1" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="313.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделена &lt;b&gt;myshop&lt;/b&gt;. Нажали &lt;b&gt;Del&lt;/b&gt; в боксе IDE (выбран mymap.ide)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="27" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="163" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Вместе с моделью берётся её LOD-партнёр LODmyshop." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="187" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Строка ищется по Model ID (у LOD с ID 0 — ID модели + 1). Имя в строке должно совпасть с именем модели или с именем из памяти — иначе «ID N в файле принадлежит «…», а не «…» — не удалено»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="217" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="265" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="Строки удаляются, остальные — байт в байт." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="262" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="295" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Если этот ID ещё стоит в IPL у других объектов — предупреждение «ID N ещё стоит в IPL у K объектов». Строки IPL остаются: игра получит расстановку без определения модели." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="292" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="IDE-связь снимается → «Не в IDE». Model ID, TXD, Draw Dist остаются в Blender." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="337" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память на &lt;b&gt;myshop&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="379" width="750" height="24" as="geometry"/></mxCell>
        <mxCell id="Mh0" value="&lt;b&gt;что помнит&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="403" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Mh1" value="&lt;b&gt;было&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="403" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mh2" value="&lt;b&gt;стало&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="403" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf0" value="IDE-файл, ID, имя" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="423" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma0" value="mymap.ide · 18650 · myshop" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="423" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb0" value="&lt;b&gt;—&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="423" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf1" value="статус IDE" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="443" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma1" value="«В IDE (mymap.ide)»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="443" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb1" value="&lt;b&gt;«Не в IDE»&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="443" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="a89" value="читает" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="Bh5" target="btn"><mxGeometry x="-0.8560" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="151.0"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="a90" value="пишет" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="st1" target="Ah5"><mxGeometry x="-0.8473" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="962" y="200"/><mxPoint x="962" y="445.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n0" value="Строки с таким ID нет — модель молча пропускается. 🗑️ в строке IDE модели — то же в «своём» IDE модели." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="477" width="880" height="26" as="geometry"/></mxCell>
