        <mxCell id="a106" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="b3" target="m"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="790" y="445"/><mxPoint x="790" y="900"/></Array></mxGeometry></mxCell>
        <mxCell id="a107" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="b4" target="m"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="790" y="570"/><mxPoint x="790" y="900"/></Array></mxGeometry></mxCell>
        <mxCell id="a108" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="b5" target="m"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="790" y="705"/><mxPoint x="790" y="900"/></Array></mxGeometry></mxCell>
        <mxCell id="q6" value="Есть &lt;b&gt;LOD-объект&lt;/b&gt; в сцене?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LOD partner или имя LOD + имя модели;&lt;br&gt;его ID и имя не совпадают с моделью&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;LOD-строка из LOD-объекта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;в точке модели; ID свой, а если 0 — ID модели + 1&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="q7" value="В &lt;b&gt;IDE&lt;/b&gt; есть LOD этой модели?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;своём, в боксе IDE или в списке&lt;br&gt;«IDE для экспорта»; ID модели + 1 в приоритете&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="955" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;LOD-строка по данным из IDE&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="1090" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;LOD не трогаем&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;был у строки — остаётся;&lt;br&gt;у новой строки LOD нет&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="800" y="970" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="q8" value="У строки модели уже есть&lt;br&gt;&lt;b&gt;своя LOD-строка&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;и больше никто на неё&lt;br&gt;не ссылается&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Обновить LOD-строку&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="1205" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;Добавить LOD-строку&lt;/b&gt;;&lt;br&gt;в колонку LOD модели — её номер" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1320" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="vc" value="⚠ &lt;b&gt;VC / III:&lt;/b&gt; колонки LOD в строке нет — после перечитывания файла аддон не видит LOD-строку и при каждом Add &lt;b&gt;добавляет её заново&lt;/b&gt; (ошибка)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="1300" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Записать файл&lt;/b&gt; (если что-то изменилось; файла нет — создаётся; первый раз за сессию — копия .bak) → аддон &lt;b&gt;запоминает&lt;/b&gt;: файл, ID, имя, позицию, поворот и номер LOD-строки → статус &lt;b&gt;«В IPL (map.ipl)»&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1420" width="700" height="70" as="geometry"/></mxCell>
        <mxCell id="a109" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="m" target="q6"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a110" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q6" target="b7"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
