        <mxCell id="sb5_855_3_L0" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="512.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="&lt;b&gt;myhouse_DFF.001&lt;/b&gt; — копия (Shift+D) myhouse_DFF, Location 100, 260, 10. Статус «Копия — добавится новым инстансом». Нажали &lt;b&gt;Add в боксе IPL&lt;/b&gt; (выбран mymap.ipl)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="43" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="179" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="206" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Копия унаследовала память оригинала, но её имя не совпадает с «владельцем» строки → аддон снимает с неё чужую связь («1 копий — добавлены новыми расстановками»)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="203" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="251" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Своей строки нет → новая строка модели перед end: ID и имя те же (myhouse), точка — копии." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="248" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="281" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="LOD partner копии — тот же myhouse_LOD. У новой строки LOD-строки нет → дописывается &lt;b&gt;своя&lt;/b&gt; LOD-строка в точке копии." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="278" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="311" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="В колонку LOD новой строки — номер её LOD-строки: &lt;b&gt;8&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="308" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="341" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="Строка №0 занята оригиналом. Его LOD-строку №1 копия тоже не берёт: у новой строки своей LOD-ссылки нет, и LOD дописывается новой строкой." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="338" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st6" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="371" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt6" value="Копия запоминает свою строку; «владелец» теперь myhouse_DFF.001 → «В IPL (mymap.ipl)»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="368" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память на &lt;b&gt;myhouse_DFF.001&lt;/b&gt; (была унаследована от оригинала)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="750" height="24" as="geometry"/></mxCell>
        <mxCell id="Mh0" value="&lt;b&gt;что помнит&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="434" width="170" height="20" as="geometry"/></mxCell>
