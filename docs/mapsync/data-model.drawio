        <mxCell id="pn1_1" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="674" y="244" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="pn1_2" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="697" y="244" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a8" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.1000;entryPerimeter=0;" edge="1" parent="1" source="p1" target="ipl"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a9" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.1638;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="A" target="p1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Del&lt;/b&gt; в боксе IPL / 🗑️ — удаляет строку и ненужную LOD-строку, &lt;b&gt;пересчитывает номера LOD&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="322" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="pn2_0" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="674" y="314" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="pn2_1" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="697" y="314" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a10" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.2892;entryPerimeter=0;" edge="1" parent="1" source="p2" target="ipl"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a11" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.2233;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="A" target="p2"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Наблюдатель&lt;/b&gt; — файл поправили снаружи: связь едет за строкой (до 2 м) или снимается" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="392" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="pn3_0" value="7" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#757575;strokeColor=#757575;" vertex="1" parent="1"><mxGeometry x="697" y="384" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a12" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.4784;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="ipl" target="p3"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a13" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.2827;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p3" target="A"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4" value="&lt;b&gt;🔄 Sync / ▶ / Check&lt;/b&gt; — ставят объекты на строки и связывают (Check — без перемещения)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="462" width="530" height="50" as="geometry"/></mxCell>
