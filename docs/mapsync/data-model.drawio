        <mxCell id="p5" value="&lt;b&gt;Export&lt;/b&gt; в боксе IPL — новый файл целиком из выделенного; связи не ставит" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="532" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="a16" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.8568;entryPerimeter=0;" edge="1" parent="1" source="p5" target="ipl"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a17" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.4015;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="A" target="p5"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Найти IDE&lt;/b&gt; — какие IDE игры описывают ID из IPL → заменяет ими список «IDE для экспорта»" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="642" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="a18" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.0974;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="ide" target="p6"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a19" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.4949;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p6" target="A"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Add&lt;/b&gt; в боксе IDE / в строке IDE — переписывает строку на месте или дописывает перед end; сменили ID — перенумеровывает" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="712" width="530" height="50" as="geometry"/></mxCell>
