        <mxCell id="im6" value="mytree_txd.txd" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="432" y="707" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="im7" value="mybarn.dff" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="620" y="707" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="im8" value="LODmybarn.dff" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=0;" vertex="1" parent="1"><mxGeometry x="56" y="731" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="im9" value="mybarn.col" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="244" y="731" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="im10" value="mybarn_txd.txd" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="432" y="731" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="LL" value="&lt;font color=&quot;#c62828&quot;&gt;⟶&lt;/font&gt; красная стрелка: колонка LOD строки указывает на строку с этим &lt;b&gt;№&lt;/b&gt;. № считается с 0 только по строкам inst — комментарии, inst и end не в счёт; в файле № не пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="767" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="b1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="26" y="198.5" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="26" y="479.5" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="26" y="682" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="858" y="198.5" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="btn" value="Нажали &lt;b&gt;«Импорт»&lt;/b&gt;. «IPL для импорта» (тот же список, что «IPL для экспорта»): mymap.ipl · бокс IDE пуст → все IDE папки игры (по gta.dat) · IMG: gta3.img · тумблеры &lt;b&gt;«LOD»&lt;/b&gt;, &lt;b&gt;«TXD»&lt;/b&gt;, &lt;b&gt;«COL»&lt;/b&gt; включены (по умолчанию все три выключены: LOD-строки пропускаются, текстуры и коллизия не грузятся)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="59" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="195" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="222" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Каждая строка inst → объект в точке &lt;b&gt;PosX, PosY, PosZ&lt;/b&gt; с поворотом &lt;b&gt;RotX..RotW&lt;/b&gt;; Model ID = колонка &lt;b&gt;ID&lt;/b&gt;. Колонка Interior не читается (остаётся 0)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="219" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="252" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="По ID ищется строка в IDE: TXD ← &lt;b&gt;TXDName&lt;/b&gt;, Draw Dist ← &lt;b&gt;DrawDist&lt;/b&gt; (у LOD — в LOD Dist), IDE Flags ← &lt;b&gt;Flags&lt;/b&gt;. Где ищется: файл из бокса IDE, если он выбран, иначе все IDE папки игры; плюс «IDE с моделями из IPL». ID есть в нескольких — побеждает первый (сначала бокс IDE)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="249" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="297" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="Из IMG достаются &lt;b&gt;ModelName.dff&lt;/b&gt;, &lt;b&gt;ModelName.col&lt;/b&gt; (если включён «COL») и &lt;b&gt;TXDName.txd&lt;/b&gt; (если включён «TXD»). Имена объектов: myhouse&lt;b&gt;_DFF&lt;/b&gt;, myhouse&lt;b&gt;_LOD&lt;/b&gt;, myhouse&lt;b&gt;_COL&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="294" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="342" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Колонка &lt;b&gt;LOD&lt;/b&gt; → поле «LOD partner»: у myhouse_DFF это объект строки №1 (myhouse_LOD). Строка, на которую ссылается чья-то колонка LOD, считается LOD." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="339" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="387" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="На модели запоминается: IPL-файл и строка (ID, имя, позиция, поворот, номер LOD-строки &lt;b&gt;внутри своего файла&lt;/b&gt;), IDE-файл и снимок строки, архив IMG. По этой памяти потом работают Add, Del, Check и наблюдатель." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="384" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="sch0" value="&lt;b&gt;Объект&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="439" width="118" height="20" as="geometry"/></mxCell>
        <mxCell id="sch1" value="&lt;b&gt;строка IPL&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1118" y="439" width="70" height="20" as="geometry"/></mxCell>
