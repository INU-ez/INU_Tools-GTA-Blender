        <mxCell id="RLt1" value="строка переписана (жирным — что изменилось)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="186" y="657" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RL2" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="489" y="660" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt2" value="строка удалена" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="511" y="657" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611" y="657" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="LL" value="В IDE колонки-номера нет: на строки IDE никто не ссылается по номеру, поэтому при удалении и вставке ничего не пересчитывается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="680" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_434_3_L0" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="455.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb3_434_4_L1" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="474.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb4_434_8_L0" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="550.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb5_434_9_L1" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="569.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделены &lt;b&gt;myshop&lt;/b&gt; (новая: Model ID 18640, TXD myshop_txd, Draw Dist 299, LOD partner LODmyshop, LOD Dist 999) и &lt;b&gt;myhouse_DFF&lt;/b&gt; (Draw Dist 300 → &lt;b&gt;400&lt;/b&gt;). Нажали &lt;b&gt;Add&lt;/b&gt; в боксе IDE (выбран mymap.ide)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="43" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="179" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="206" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="К каждой модели сама добавляется её LOD-партнёр: LODmyshop и myhouse_LOD." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="203" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="236" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="&lt;b&gt;myhouse&lt;/b&gt;: ID 18631 есть, имя совпадает → строка переписана на месте, DrawDist 400." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="233" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="266" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="&lt;b&gt;LODmyhouse&lt;/b&gt;: ID 18632, имя совпадает, значения те же → строка не тронута («без изменений»)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="263" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="296" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="&lt;b&gt;myshop&lt;/b&gt;: ни ID, ни имени в файле нет → новая строка перед &lt;b&gt;end&lt;/b&gt; последней секции objs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="293" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="326" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="&lt;b&gt;LODmyshop&lt;/b&gt; — сразу за моделью: Model ID 0 → ID модели + 1 = 18641; TXD — как у модели; DrawDist — LOD Dist модели." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="323" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st6" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="356" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt6" value="Пересчитывать нечего; остальные строки — байт в байт. Запись через временный файл, .bak при первой записи за сессию." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="353" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st7" value="7" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="386" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt7" value="Запоминает снимок строки → «В IDE (mymap.ide)». Поля объекта не меняются: у LODmyshop Model ID остаётся 0 → его статус «Не в IDE — сменился ID (был 18641)»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="383" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память на &lt;b&gt;myshop&lt;/b&gt; (снимок строки)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="750" height="24" as="geometry"/></mxCell>
        <mxCell id="Mh0" value="&lt;b&gt;что помнит&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="464" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Mh1" value="&lt;b&gt;было&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="464" width="290" height="20" as="geometry"/></mxCell>
