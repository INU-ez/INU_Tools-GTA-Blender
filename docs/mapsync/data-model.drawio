        <mxCell id="RLt0" value="новая строка" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="695" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RL1" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="164" y="698" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt1" value="строка переписана (жирным — что изменилось)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="186" y="695" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RL2" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="489" y="698" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt2" value="строка удалена" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="511" y="695" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611" y="695" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="LL" value="&lt;font color=&quot;#c62828&quot;&gt;⟶&lt;/font&gt; красная стрелка: колонка LOD строки указывает на строку с этим &lt;b&gt;№&lt;/b&gt;. № считается с 0 только по строкам inst — комментарии, inst и end не в счёт; в файле № не пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="718" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb1_547_3_L0" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="199.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_126_9_L0" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb3_126_10_L1" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="607.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb4_126_11_L0" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="626.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb5_126_9_R0" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="858" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделена &lt;b&gt;myshop&lt;/b&gt;: Location 150, 220, 10 · Model ID 18640 · LOD partner — &lt;b&gt;LODmyshop&lt;/b&gt; (его Model ID = 0). Нажали &lt;b&gt;Add&lt;/b&gt; в боксе IPL." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="27" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="163" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Читает mymap.ipl целиком. Строки, которые не нужно менять, потом запишет байт в байт — с комментариями и своим видом чисел." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="187" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="myshop в этот файл ещё не записывался → свою строку не ищет, строка будет &lt;b&gt;новой&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="217" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="LOD: у LODmyshop Model ID 0 → в файл идёт &lt;b&gt;ID модели + 1 = 18641&lt;/b&gt;. Точка и поворот LOD-строки — как у модели." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="247" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Новые строки встают перед &lt;b&gt;end&lt;/b&gt; последней секции inst: сначала модель, сразу за ней её LOD. Числа — с 6 знаками после точки." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="277" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="310" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="Номер LOD: LODmyshop — строка &lt;b&gt;№6&lt;/b&gt; (№ считается только по строкам inst) → в колонку LOD строки myshop пишется &lt;b&gt;6&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="307" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st6" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt6" value="Файл пишется во временный и подменяет старый; при первой записи за сессию рядом появляется &lt;b&gt;mymap.ipl.bak&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="337" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st7" value="7" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="370" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt7" value="Запоминает на myshop то, что записал (таблица ниже). Через ≤ 2 с наблюдатель замечает, что файл изменился, находит строку на месте — ничего не меняет." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="367" width="850" height="41" as="geometry"/></mxCell>
