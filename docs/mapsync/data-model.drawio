        <mxCell id="a112" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q7" target="b8"><mxGeometry x="-0.2000" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a113" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="q7" target="b9"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a114" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="b7" target="q8"><mxGeometry x="-0.1765" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a115" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="b8" target="q8"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="590" y="1164"/><mxPoint x="210" y="1164"/></Array></mxGeometry></mxCell>
        <mxCell id="a116" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="q8" target="b10"><mxGeometry x="-0.4500" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a117" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q8" target="b11"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a118" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.2143;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="b11" target="end"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a119" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="b10" target="end"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="790" y="1235"/><mxPoint x="790" y="1455"/></Array></mxGeometry></mxCell>
        <mxCell id="a120" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=1.0000;entryY=0.7000;entryPerimeter=0;" edge="1" parent="1" source="b9" target="end"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="915" y="1469"/></Array></mxGeometry></mxCell>
        <mxCell id="a121" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1;strokeColor=#c62828;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#c62828;spacing=3;exitX=0.0000;exitY=0.7000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="vc" target="b11"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Перед записью&lt;/b&gt; аддон делает пробный прогон. Нашлись проблемы (например: строка осталась в старом файле; прежняя строка не найдена; LOD занимает чужой ID) — показывает список и спрашивает «Продолжить?». Нет — пишет сразу." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="800" height="70" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Модель не записывается&lt;/b&gt; (ошибка в отчёте), если:&lt;br&gt;• Model ID = 0 — сначала выдать ID (ID Manager)&lt;br&gt;• модель без связи или копия, а в боксе IPL файл не выбран — «нет своего IPL» (копия при этом уже отвязана)&lt;br&gt;• IPL-файл (выбранный или свой) бинарный, из IMG — его править нельзя&lt;br&gt;• это коллизия — в том числе меш без текстуры (пропускается молча)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="176" width="800" height="120" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Выделен LOD без своей модели&lt;/b&gt; — перепишутся строки моделей, которые его используют (с их текущими координатами), в их файлах. Таких нет — «LOD без основной модели — выдели основную модель»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="312" width="800" height="64" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;«Add» в строке статуса модели&lt;/b&gt; — пишет все выделенные модели, каждую в её собственный файл (бокс IPL не используется). Копию и модель без связи не пишет: «нет своего IPL», а копия при этом теряет связь — их добавляйте кнопкой Add в боксе." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="392" width="800" height="80" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Строку правили в файле&lt;/b&gt; — аддон сам заметит за 2 с (вкладка «Файл изменили снаружи»): сдвинули ≤ 2 м — связь переедет, статус «координаты разошлись»; удалили — связь снимется, и Add запишет модель как новую в файл из бокса. Поэтому «2 м» в дереве срабатывает, только если Add нажали сразу после правки." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="488" width="800" height="80" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◇ ромб — вопрос, из него две стрелки: &lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt; / &lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;◆&lt;/font&gt; голубой — пришли по «да», &lt;font color=&quot;#b85450&quot;&gt;◆&lt;/font&gt; красный — пришли по «нет»&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; зелёный — результат, всё в порядке&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; жёлтый — сработало, но с предупреждением&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; красный — куда ведёт ответ «нет»&lt;br&gt;□ белый — действие аддона" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="584" width="380" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p16" name="Файл изменили снаружи">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Файл IPL или IDE изменили в другой программе — что делает аддон сам&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Аддон ничего не пишет в файлы и не двигает объекты — он только проверяет связи и меняет статусы." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="w0" value="Раз в &lt;b&gt;2 с&lt;/b&gt; (и один раз после открытия .blend):&lt;br&gt;у связанного файла изменились&lt;br&gt;&lt;b&gt;время или размер&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="400" y="85" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="w0n" value="Ничего не делать" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="840" y="115" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a122" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="w0" target="w0n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ipl_h" value="&lt;b&gt;Это IPL&lt;/b&gt; — для каждой связанной модели" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="i1" value="Файл &lt;b&gt;есть&lt;/b&gt; на диске?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="i1n" value="&lt;b&gt;Снять связь у всех&lt;/b&gt; моделей&lt;br&gt;этого файла → «Не в IPL»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="325" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="i2" value="Файл &lt;b&gt;читается&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;не бинарный&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="i2n" value="Ничего не трогать" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="i3" value="Строка на &lt;b&gt;прежнем месте&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;тот же ID, не дальше 1 см&lt;br&gt;от запомненного&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="i3y" value="&lt;b&gt;Связь остаётся&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;поворот и другие поля не сверяются&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="i4" value="В радиусе &lt;b&gt;2 м&lt;/b&gt; от прежнего&lt;br&gt;места есть свободная строка&lt;br&gt;с тем же ID?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="i4y" value="&lt;b&gt;Связь переезжает&lt;/b&gt; на эту строку.&lt;br&gt;Объект стоит по-старому →&lt;br&gt;«координаты разошлись»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="695" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="i5" value="&lt;b&gt;Снять связь&lt;/b&gt; → «Не в IPL»&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;строку удалили, сменили ID или унесли дальше 2 м&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="a123" value="IPL" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.3500;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="w0" target="ipl_h"><mxGeometry x="-0.6739" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="533" y="215"/><mxPoint x="210" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="a124" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="ipl_h" target="i1"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a125" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="i1" target="i1n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a126" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="i1" target="i2"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a127" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="i2" target="i2n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a128" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="i2" target="i3"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a129" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="i3" target="i3y"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a130" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="i3" target="i4"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a131" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="i4" target="i4y"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a132" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="i4" target="i5"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ide_h" value="&lt;b&gt;Это IDE&lt;/b&gt; — для каждой связанной модели" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="d1" value="Файл &lt;b&gt;есть&lt;/b&gt; на диске?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="d1n" value="&lt;b&gt;Снять связь у всех&lt;/b&gt; моделей&lt;br&gt;этого файла → «Не в IDE»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="325" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="d1b" value="Файл &lt;b&gt;читается&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;не занят другой программой&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="d1bn" value="Ничего не трогать" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="445" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="Строка с этим &lt;b&gt;ID&lt;/b&gt; есть?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="550" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="d2n" value="&lt;b&gt;Снять связь&lt;/b&gt; → «Не в IDE»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="565" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Имя&lt;/b&gt; в строке совпадает&lt;br&gt;с запомненным?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="670" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="d3n" value="&lt;b&gt;Снять связь&lt;/b&gt; → «Не в IDE»&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;под этим ID теперь другая модель&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="690" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;Связь остаётся&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TXD, дальность и флаги не сверяются —&lt;br&gt;подтянуть из файла: ▶ или 🔄&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="a133" value="IDE" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.6500;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="w0" target="ide_h"><mxGeometry x="-0.8148" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="647" y="215"/><mxPoint x="1250" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="a134" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="ide_h" target="d1"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a135" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="d1" target="d1n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a136" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d1" target="d1b"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a137" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="d1b" target="d1bn"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a138" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d1b" target="d2"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a139" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="d2" target="d2n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a140" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a141" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="d3" target="d3n"><mxGeometry x="-0.2667" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a142" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d3" target="d4"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="wn" value="• &lt;b&gt;Копии&lt;/b&gt; (Shift+D) по IPL не проверяются — своей строки у них ещё нет. По IDE проверяются как обычные модели.&lt;br&gt;• Файл &lt;b&gt;на миг пропал или оказался пустым&lt;/b&gt; (другой редактор сохраняет через удаление или перезапись, сетевой диск) — связь снимется. Вернуть связь с IPL: &lt;b&gt;Check&lt;/b&gt; (ничего не двигает) или &lt;b&gt;🔄&lt;/b&gt; в «IPL для экспорта» (переставит объекты по файлу). С IDE — только &lt;b&gt;🔄&lt;/b&gt; в «IDE для экспорта» (перепишет ID, TXD, дальность и флаги из файла).&lt;br&gt;• Файла нет &lt;b&gt;уже при открытии .blend&lt;/b&gt; (другой ПК, переименовали папку) — связи не снимаются, статусы остаются прежними.&lt;br&gt;• Связь с IPL снята — &lt;b&gt;не жмите сразу Add&lt;/b&gt;: он допишет новую строку, и если старая в файле есть — будет дубль. Сначала &lt;b&gt;Check&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="1360" height="120" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◇ ромб — вопрос, из него две стрелки: &lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt; / &lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;◆&lt;/font&gt; голубой — пришли по «да», &lt;font color=&quot;#b85450&quot;&gt;◆&lt;/font&gt; красный — пришли по «нет»&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; зелёный — результат, всё в порядке&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; жёлтый — сработало, но с предупреждением&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; красный — куда ведёт ответ «нет»&lt;br&gt;□ белый — действие аддона" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1460" y="890" width="380" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p17" name="Что где лежит">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Как модель из Blender попадает в IPL, IDE и IMG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Пример: модель &lt;b&gt;myhouse&lt;/b&gt; и её LOD &lt;b&gt;LODmyhouse&lt;/b&gt;. &lt;b&gt;Одинаковый цвет — одно и то же значение&lt;/b&gt;: строка в Blender → колонка в файле. Игра читает сверху вниз: IPL → по ID → IDE → по имени → IMG." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="bl_t" value="&lt;b&gt;BLENDER&lt;/b&gt; — панель «IDE / Placement»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="380" height="24" as="geometry"/></mxCell>
        <mxCell id="m_h" value="Объект &lt;b&gt;myhouse&lt;/b&gt; — модель" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="116" width="380" height="30" as="geometry"/></mxCell>
        <mxCell id="m_name" value="&lt;b&gt;Имя объекта&lt;/b&gt;: myhouse" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="146" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_pos" value="&lt;b&gt;Location&lt;/b&gt;: 100, 200, 10" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d0f0ef;strokeColor=#3a9d9b;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="172" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_rot" value="&lt;b&gt;Rotation&lt;/b&gt;: 0°, 0°, 0°" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f0f4c3;strokeColor=#9e9d24;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="198" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_id" value="&lt;b&gt;Model ID&lt;/b&gt;: 18631" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="224" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_txd" value="&lt;b&gt;TXD&lt;/b&gt;: myhouse_txd" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_dist" value="&lt;b&gt;Draw Dist&lt;/b&gt;: 300" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="276" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_int" value="&lt;b&gt;Interior&lt;/b&gt;: 0" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fce4ec;strokeColor=#c2185b;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="302" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_flags" value="&lt;b&gt;IDE Flags&lt;/b&gt;: 0" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#eeeeee;strokeColor=#888888;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="328" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m_lod" value="&lt;b&gt;LOD partner&lt;/b&gt;: LODmyhouse" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="354" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="l_h" value="Объект &lt;b&gt;LODmyhouse&lt;/b&gt; — LOD" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="380" height="30" as="geometry"/></mxCell>
        <mxCell id="l_name" value="&lt;b&gt;Имя объекта&lt;/b&gt;: LODmyhouse" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="l_id" value="&lt;b&gt;LOD ID&lt;/b&gt;: 18632 &lt;i&gt;(0 → ID модели + 1)&lt;/i&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="496" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="l_dist" value="&lt;b&gt;LOD Dist&lt;/b&gt;: 1500" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="l_pos" value="&lt;b&gt;Location&lt;/b&gt;: не важна — в IPL берётся точка модели" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d0f0ef;strokeColor=#3a9d9b;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="548" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="bl_note" value="Строки LOD пишутся той же кнопкой &lt;b&gt;Add&lt;/b&gt;, что и модель. Имя в файлах = имя объекта без «.001» и маркеров _DFF / _LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="596" width="380" height="64" as="geometry"/></mxCell>
        <mxCell id="a143" value="указатель" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="m_lod" target="l_h"><mxGeometry x="-0.2857" relative="1" as="geometry"><mxPoint x="-2" y="0" as="offset"/><Array as="points"><mxPoint x="8" y="367"/><mxPoint x="8" y="455"/></Array></mxGeometry></mxCell>
        <mxCell id="ipl_t" value="&lt;b&gt;IPL-файл&lt;/b&gt; (map.ipl), секция inst — &lt;b&gt;ГДЕ стоит модель&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="900" height="26" as="geometry"/></mxCell>
        <mxCell id="ih0" value="&lt;b&gt;№&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="520" y="126" width="44" height="30" as="geometry"/></mxCell>
        <mxCell id="i0_0" value="0" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="520" y="156" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="i1_0" value="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="520" y="184" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="ih1" value="&lt;b&gt;ID&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=0;" vertex="1" parent="1"><mxGeometry x="564" y="126" width="80" height="30" as="geometry"/></mxCell>
