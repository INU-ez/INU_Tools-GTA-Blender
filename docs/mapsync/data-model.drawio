        <mxCell id="Mf7" value="статус IPL в панели" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="548" width="170" height="20" as="geometry"/></mxCell>
