        <mxCell id="Sc2" value="&lt;b&gt;6&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1540" y="681" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="Sn" value="Add это число не читает — при каждой записи номера считаются заново по файлу. Старое число видно в поле «LOD» (N-панель → Object IDE / IPL) и берётся &lt;b&gt;полным Export IPL&lt;/b&gt;, если у модели не задан LOD partner." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="701" width="880" height="38" as="geometry"/></mxCell>
        <mxCell id="a68" value="читает" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="Bh12" target="btn"><mxGeometry x="-0.6145" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="151.0"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="a69" value="пишет" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="st1" target="Ah12"><mxGeometry x="-0.7576" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="962" y="200"/><mxPoint x="962" y="502.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n0" value="Модель &lt;b&gt;не связана&lt;/b&gt; с этим файлом (или это копия) → строка ищется по текущему Model ID и &lt;b&gt;текущей&lt;/b&gt; позиции объекта в радиусе 0,5 м." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="751" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n1" value="🗑️ в строке IPL модели — то же самое в «своём» файле модели. 🗑️ у имени модели удаляет и из IPL, и из IDE — без окна «Продолжить?»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="785" width="880" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
