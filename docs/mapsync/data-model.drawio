        <mxCell id="img_t" value="&lt;b&gt;IMG-архив&lt;/b&gt; (gta3.img) — &lt;b&gt;ФАЙЛЫ модели&lt;/b&gt;. Имя записи — не длиннее 23 символов." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="644" y="514" width="700" height="40" as="geometry"/></mxCell>
