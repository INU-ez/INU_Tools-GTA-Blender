        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;4. «Add» — копия Shift+D: своя строка и своя LOD-строка&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Копия получает новую расстановку; строки оригинала не трогаются." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
