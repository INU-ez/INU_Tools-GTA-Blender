        <mxCell id="LL" value="&lt;font color=&quot;#c62828&quot;&gt;⟶&lt;/font&gt; красная стрелка: колонка LOD строки указывает на строку с этим &lt;b&gt;№&lt;/b&gt;. № считается с 0 только по строкам inst — комментарии, inst и end не в счёт; в файле № не пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="404" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="pb1" value="T" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#6c8ebf;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="26" y="217.5" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="pb2" value="S" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#6c8ebf;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="26" y="255.5" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделены &lt;b&gt;mytree_DFF&lt;/b&gt; (T, активная: связь есть, память 121, объект стоит на 120) и &lt;b&gt;myshop&lt;/b&gt; (S: связь снята на вкладке 7, объект на 150, строка в файле на 155). ▶ активна, только если &lt;b&gt;активная&lt;/b&gt; модель связана — поэтому активна mytree_DFF; ▶ берёт всё выделенное." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="43" as="geometry"/></mxCell>
        <mxCell id="pth0" value="&lt;b&gt;кнопка&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="179" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="pth1" value="&lt;b&gt;mytree_DFF&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="179" width="330" height="22" as="geometry"/></mxCell>
        <mxCell id="pth2" value="&lt;b&gt;myshop&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1500" y="179" width="380" height="22" as="geometry"/></mxCell>
        <mxCell id="pr00" value="&lt;b&gt;🔄 Sync&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;шапка «IPL для экспорта»&lt;/font&gt;&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="201" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="pr01" value="своя строка по памяти → объект &lt;b&gt;переезжает на 121&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="201" width="330" height="58" as="geometry"/></mxCell>
        <mxCell id="pr02" value="строки с ID 18640 ближе 0,5 м нет → &lt;b&gt;пропущена&lt;/b&gt;, связи нет" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="1500" y="201" width="380" height="58" as="geometry"/></mxCell>
        <mxCell id="pr10" value="&lt;b&gt;▶&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;строка IPL модели&lt;/font&gt;&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="259" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="pr11" value="своя строка → объект &lt;b&gt;переезжает на 121&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="259" width="330" height="58" as="geometry"/></mxCell>
        <mxCell id="pr12" value="ближайшая свободная строка с ID 18640 &lt;b&gt;на любом расстоянии&lt;/b&gt; → объект переезжает на 155, связь есть" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="1500" y="259" width="380" height="58" as="geometry"/></mxCell>
        <mxCell id="pr20" value="&lt;b&gt;Check&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;у имени модели&lt;/font&gt;&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="317" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="pr21" value="связь подтверждена, объект &lt;b&gt;не двигается&lt;/b&gt; → «координаты разошлись»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="317" width="330" height="58" as="geometry"/></mxCell>
        <mxCell id="pr22" value="&lt;b&gt;единственная&lt;/b&gt; свободная строка с ID 18640 в файле → связь без перемещения → «координаты разошлись»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1500" y="317" width="380" height="58" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Общие правила поиска&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="391" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="418" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Файлы: список «IPL для экспорта» (это тот же список, что «IPL для импорта» на вкладке Импорт) + все .ipl в папке игры; если оба пусты — IPL из бокса." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="415" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="463" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Связанная модель ищет строку в &lt;b&gt;своём&lt;/b&gt; файле: ID и позиция из памяти, 1 см, потом 2 м." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="460" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="493" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="Для несвязанных моделей строки связанных заняты заранее. Связанные ищут свою строку по очереди: запасной поиск в 2 м может забрать строку другой связанной модели, если её строку двигали руками (проверено прогоном). Надёжнее выделить обе модели или дождаться наблюдателя." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="538" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Несвязанная модель (или копия) ищет строку со своим Model ID в радиусе &lt;b&gt;0,5 м&lt;/b&gt; от того места, где объект стоит сейчас; файлы по порядку, берётся первый с совпадением. Дальше — ▶: ближайшая на любом расстоянии в первом по списку файле, где такая строка есть; Check: только если в файле она одна." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="535" width="850" height="55" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="597" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="Model ID, Interior и имя объекта не меняются; поле «LOD» = колонка LOD строки. Строка связанной модели пропала: Check снимает связь («Не в IPL»), 🔄 Sync и ▶ ищут ей строку заново, как несвязанной." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="594" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="n0" value="Без выделения 🔄 Sync и Check берут &lt;b&gt;все&lt;/b&gt; модели .blend (и других сцен)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="649" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n1" value="IDE-часть Check: только проверяет, есть ли Model ID в IDE (имя не сверяет); нет — снимает связь с IDE, но не ставит её. Связь с IDE ставит 🔄 в шапке «IDE для экспорта»: ищет модель по имени, потом по Model ID во всех IDE папки игры (или в файле бокса IDE; сам список под кнопкой не читает) и переписывает Model ID, TXD, DrawDist, Flags из файла. ▶ в строке IDE делает то же, но активна только у уже связанной модели." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="681" width="880" height="55" as="geometry"/></mxCell>
        <mxCell id="a84" value="читает" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="Ph12" target="btn"><mxGeometry x="-0.6126" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="151.0"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p10" name="9 IDE: Add">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;9. «Add» в боксе IDE — строка переписывается на месте или дописывается перед end&lt;/b&gt;&lt;/font&gt;&lt;br&gt;IDE проще IPL: строки находятся по ID с проверкой имени, номеров строк нет." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="gh" value="🎮 &lt;b&gt;ИГРА&lt;/b&gt; — файл &lt;b&gt;data/maps/mymap.ide&lt;/b&gt;, секция objs" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="900" height="30" as="geometry"/></mxCell>
