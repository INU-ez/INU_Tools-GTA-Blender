        <mxCell id="btn" value="&lt;b&gt;myhouse_DFF&lt;/b&gt; сдвинули: Location x 100 → &lt;b&gt;105&lt;/b&gt;. Статус был «В IPL, координаты разошлись». Нажали &lt;b&gt;Add&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="27" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="163" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Ищет свою строку по памяти: ID 18631 и позиция &lt;b&gt;100, 200, 10&lt;/b&gt; (где модель стояла при прошлой записи, а не где стоит сейчас), допуск 1 см → строка №0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="187" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="235" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Переписывает строку №0 на месте новыми числами — строка переписывается целиком." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="232" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="265" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="LOD: в колонке LOD строки №0 — 1; на строку №1 больше никто не ссылается → она обновляется на месте: точка и поворот — как у модели." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="262" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="295" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Строк не прибавилось и не убавилось → колонка LOD у всех строк прежняя." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="292" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="325" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="Запоминает новую позицию 105, 200, 10 → статус «В IPL (mymap.ipl)»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="322" width="850" height="26" as="geometry"/></mxCell>
