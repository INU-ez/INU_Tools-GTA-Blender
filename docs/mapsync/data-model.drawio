        <mxCell id="p9" value="&lt;b&gt;▶ / 🔄 Sync IDE&lt;/b&gt; — Model ID, TXD, DrawDist, Flags из файла в Blender" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="852" width="530" height="50" as="geometry"/></mxCell>
