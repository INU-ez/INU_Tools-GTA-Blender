        <mxCell id="sb4_599_5_R0" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="858" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb4_599_7_R0" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="858" y="626.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb4_599_9_R0" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="858" y="664.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb5_599_5_L1" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделена &lt;b&gt;myhouse_DFF&lt;/b&gt; (оригинал). Нажали &lt;b&gt;Del&lt;/b&gt; в боксе IPL (выбран mymap.ipl)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="27" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="163" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Ищет свою строку по памяти: ID 18631, позиция 105, 200, 10, допуск 1 см (запасного радиуса 2 м у Del нет) → №0. Удаляет её." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="187" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Её LOD-строка №1: кроме удалённой на неё никто не ссылается → удаляется тоже. Если бы на неё ссылалась другая строка — осталась бы." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="217" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="Строки ниже поднимаются: было №2 → стало №0, №3 → №1 и так далее." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="247" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Колонка LOD пересчитывается у &lt;b&gt;всех&lt;/b&gt; строк: mybarn 4 → 2, myshop 6 → 4, копия 8 → 6 — каждая указывает на ту же строку, что и раньше." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="277" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="310" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="Строки, где число изменилось, переписаны целиком (числа с 6 знаками); строки без изменений (mytree, LOD-строки) — байт в байт." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="307" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st6" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt6" value="У myhouse_DFF связь снята → «Не в IPL», поле «LOD» = −1. Объект остаётся на месте, строка IDE не трогается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="337" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память на &lt;b&gt;myhouse_DFF&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="379" width="750" height="24" as="geometry"/></mxCell>
