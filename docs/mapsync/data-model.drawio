        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611" y="771" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="LL" value="&lt;font color=&quot;#c62828&quot;&gt;⟶&lt;/font&gt; красная стрелка: колонка LOD строки указывает на строку с этим &lt;b&gt;№&lt;/b&gt;. № считается с 0 только по строкам inst — комментарии, inst и end не в счёт; в файле № не пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="794" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb1_769_3_L0" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="199.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_769_4_L1" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="218.5" width="20" height="20" as="geometry"/></mxCell>
