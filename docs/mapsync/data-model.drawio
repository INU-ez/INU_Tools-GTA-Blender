        <mxCell id="ipl_num" value="&lt;i&gt;№ — номер строки, в файле не пишется, считается с 0&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#757575;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="780" y="214" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="a144" value="LOD = 1 → строка №1" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#c62828;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#c62828;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="i0_11" target="i1_11"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/><Array as="points"><mxPoint x="1316" y="170"/><mxPoint x="1316" y="198"/></Array></mxGeometry></mxCell>
        <mxCell id="ipl_key" value="&lt;b&gt;🔑 Как аддон потом находит свою строку&lt;/b&gt;&lt;br&gt;по &lt;b&gt;ID&lt;/b&gt; и &lt;b&gt;Pos&lt;/b&gt; — с точностью 1 см.&lt;br&gt;Строку сдвинули в файле руками — ищет ту же модель в радиусе 2 м. Дальше — связь рвётся." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1480" y="126" width="400" height="110" as="geometry"/></mxCell>
