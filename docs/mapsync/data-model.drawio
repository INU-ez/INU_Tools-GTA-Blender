<mxfile host="Electron" agent="INU Tools docs" version="24.0.0">
  <diagram id="p1" name="0 Игра и аддон">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Игра и аддон: кто что читает и пишет&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Слева — папка игры и её файлы, справа — аддон в Blender, между ними — все действия. &lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;Зелёная&lt;/b&gt;&lt;/font&gt; — аддон пишет в файл игры, &lt;font color=&quot;#1565c0&quot;&gt;&lt;b&gt;синяя&lt;/b&gt;&lt;/font&gt; — читает файл и меняет Blender, &lt;b&gt;серая пунктирная&lt;/b&gt; — только проверяет или ищет. Кружок с числом — вкладка, где действие разобрано по строкам. &lt;b&gt;Опасные случаи&lt;/b&gt;, найденные прогоном кода, — вкладка 13." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="G" value="🎮 &lt;b&gt;ИГРА&lt;/b&gt; — папка игры" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=14;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="600" height="1178" as="geometry"/></mxCell>
        <mxCell id="A" value="🧩 &lt;b&gt;АДДОН&lt;/b&gt; — Blender, N-панель GTA Tools → «IDE / IPL / IMG»" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=14;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1300" y="84" width="580" height="1178" as="geometry"/></mxCell>
        <mxCell id="ptitle" value="&lt;b&gt;Действия между игрой и аддоном&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="690" y="96" width="560" height="24" as="geometry"/></mxCell>
        <mxCell id="dat" value="&lt;b&gt;data/gta.dat&lt;/b&gt; — какие файлы карты грузить игре ↓&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace&quot;&gt;IDE DATA\MAPS\mymap.ide&lt;br&gt;IPL DATA\MAPS\mymap.ipl&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;models/gta3.img — основной архив; свои архивы подключаются строкой IMG&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="ipl" value="&lt;b&gt;data/maps/mymap.ipl&lt;/b&gt; — ГДЕ стоят модели: секция &lt;b&gt;inst&lt;/b&gt;, одна строка = одна модель в мире" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="560" height="370" as="geometry"/></mxCell>
