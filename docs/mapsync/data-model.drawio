        <mxCell id="n0" value="Другие конфликты: имя модели уже есть в файле под другим ID, и это не ID из памяти → «уже есть в файле с ID N — не записана»; ID занят строкой не из objs / tobj (anim, cars, peds…) → «ID N уже занят в секции …»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="513" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="n1" value="Конфликт ищется только внутри выбранного IDE: тот же ID в другом IDE игры аддон не видит." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="562" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Check до Add&lt;/b&gt; при сменённом ID снимет связь — и Add потом выдаст конфликт «уже есть в файле»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="596" width="880" height="26" as="geometry"/></mxCell>
