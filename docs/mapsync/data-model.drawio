        <mxCell id="a148" value="Add в IPL" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=1.0000;exitY=0.2700;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="m_h" target="i0_0"><mxGeometry x="0.4587" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="430" y="124.1"/><mxPoint x="430" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="a149" value="Add в IDE" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=1.0000;exitY=0.5700;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="m_h" target="d0_0"><mxGeometry x="0.7156" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="420" y="133.1"/><mxPoint x="420" y="364"/></Array></mxGeometry></mxCell>
        <mxCell id="a150" value="Export to IMG" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=1.0000;exitY=0.8700;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="m_h" target="g_dff"><mxGeometry x="0.6184" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="410" y="142.1"/><mxPoint x="410" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="warn" value="&lt;b&gt;⚠ Где связь может порваться&lt;/b&gt;&lt;br&gt;• &lt;b&gt;LOD в IPL — это номер строки.&lt;/b&gt; Вставили или удалили строку выше вручную — LOD указывает не туда. Аддон пересчитывает номера при Add (только SA). В VC / III колонки LOD нет — и повторный Add сейчас дописывает LOD-строку ещё раз (ошибка).&lt;br&gt;• &lt;b&gt;ModelName = имя объекта.&lt;/b&gt; Переименовали объект — при следующем Add модель переименуется в IDE и IPL.&lt;br&gt;• &lt;b&gt;Строку в IPL сдвинули руками больше чем на 2 м или удалили&lt;/b&gt; — связь рвётся.&lt;br&gt;• &lt;b&gt;Файл IDE / IPL на миг пропал&lt;/b&gt; (сохранение в другом редакторе, сетевой диск) — аддон снимает связь у всех объектов этого файла.&lt;br&gt;• &lt;b&gt;Add пишет в файл, выбранный в панели&lt;/b&gt;, даже если модель уже стоит в другом IPL — там остаётся старая строка.&lt;br&gt;• &lt;b&gt;LOD ID = 0&lt;/b&gt; — в файл пишется ID модели + 1, но сам LOD этот ID не получает: панель покажет «сменился ID»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="520" y="580" width="1360" height="118" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
