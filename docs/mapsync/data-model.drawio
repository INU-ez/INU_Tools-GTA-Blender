        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="241" y="695" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="LL" value="&lt;font color=&quot;#c62828&quot;&gt;⟶&lt;/font&gt; красная стрелка: колонка LOD строки указывает на строку с этим &lt;b&gt;№&lt;/b&gt;. № считается с 0 только по строкам inst — комментарии, inst и end не в счёт; в файле № не пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="718" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_752_5_L0" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="531.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_752_8_L0" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb3_752_4_L1" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="512.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb4_752_6_L1" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="550.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="В Блокноте / MEd: строку &lt;b&gt;mytree&lt;/b&gt; сдвинули на 1 м (x 120 → 121), строку &lt;b&gt;myshop&lt;/b&gt; — на 5 м (x 150 → 155). Сохранили." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="27" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="163" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Время / размер mymap.ipl изменились → файл перечитывается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="187" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="Сначала раздаются точные совпадения (ID + позиция из памяти, 1 см): mybarn_DFF и копия myhouse_DFF.001 — на месте, ничего не меняется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="217" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="&lt;b&gt;mytree_DFF&lt;/b&gt;: на месте строки нет, но в радиусе 2 м есть свободная строка с тем же ID → связь переезжает на неё, память = 121, 210, 10. Объект стоит на 120 → «В IPL, координаты разошлись»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="247" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="295" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="&lt;b&gt;myshop&lt;/b&gt;: в радиусе 2 м строки нет → связь снимается → «Не в IPL». Строка в файле остаётся." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="292" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="325" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="В консоли Blender: «[INU links] files changed: mymap.ipl — IPL links dropped 1, IDE 0»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="322" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память после проверки" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="364" width="750" height="24" as="geometry"/></mxCell>
        <mxCell id="Mh0" value="&lt;b&gt;что помнит&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="388" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Mh1" value="&lt;b&gt;было&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="388" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mh2" value="&lt;b&gt;стало&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="388" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf0" value="mytree_DFF: позиция" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="408" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma0" value="120, 210, 10" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="408" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb0" value="&lt;b&gt;121, 210, 10&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="408" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf1" value="mytree_DFF: статус" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="428" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma1" value="«В IPL (mymap.ipl)»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="428" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb1" value="&lt;b&gt;«В IPL, координаты разошлись»&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="428" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf2" value="myshop: связь" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="448" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma2" value="mymap.ipl · 18640 · 150, 220, 10" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="448" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb2" value="&lt;b&gt;— (снята)&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="448" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mf3" value="myshop: статус" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#d0d0d0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="468" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="Ma3" value="«В IPL (mymap.ipl)»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="468" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="Mb3" value="&lt;b&gt;«Не в IPL»&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="468" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="a81" value="читает" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="Bh12" target="btn"><mxGeometry x="-0.6145" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="151.0"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="warn" value="&lt;b&gt;Не жмите сразу Add для myshop&lt;/b&gt;: связи нет, и Add допишет новую строку — в файле будет две myshop. Сначала нажмите &lt;b&gt;Check&lt;/b&gt; у имени модели — он свяжет её с единственной строкой myshop (на 155), вкладка 8. ▶ у несвязанной модели серая.&lt;br&gt;&lt;br&gt;&lt;b&gt;Удалили или вставили строку руками и не поправили колонку LOD&lt;/b&gt; — номер начинает указывать на чужую строку. Аддон номера из файла не проверяет: следующий Add модели запишет свою LOD-строку &lt;b&gt;прямо в эту чужую строку&lt;/b&gt; (проверено прогоном: ванильная строка затёрлась LOD-ом, а настоящая LOD-строка осталась лишней)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="502" width="880" height="99" as="geometry"/></mxCell>
        <mxCell id="n0" value="&lt;b&gt;Файл пропал&lt;/b&gt; (удалили, переименовали, редактор сохраняет через удаление) — связь снимается у всех моделей этого файла. Если файла нет уже при открытии .blend — связи остаются." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="611" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="n1" value="Сверяются только ID и позиция. Строку &lt;b&gt;повернули&lt;/b&gt; или сменили ей Interior / LOD — статус останется «В IPL»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;IDE&lt;/b&gt;: строки с запомненным ID нет или под ним другое имя → «Не в IDE». TXD, DrawDist и Flags из файла не сверяются." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="694" width="880" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p9" name="8 IPL: Sync, ▶, Check">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
