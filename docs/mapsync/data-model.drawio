        <mxCell id="Mb5" value="&lt;b&gt;«В IPL» · «В IDE» · «В IMG»&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1460" y="712" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="n0" value="Своей IPL-памяти у LOD нет: его строку пишет и удаляет строка модели через колонку LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="746" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n1" value="Несколько IPL сразу: номер LOD-строки каждый раз считается внутри её собственного файла." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="778" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n2" value="Бинарные IPL из архива (&lt;b&gt;*_stream*.ipl&lt;/b&gt;) «Импорт» не читает. Бинарный .ipl с диска в списке «IPL для импорта» читается, модели получают «В IPL», но Add в такой файл не пишет — «бинарный IPL — редактировать нельзя»; выберите текстовый IPL в боксе IPL." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="810" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="n3" value="Модель уже стоит в сцене в той же точке (тот же ID, позиция до 1 мм, тот же поворот) — пропускается. Та же модель в другом месте — ставится копия с общей геометрией." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="857" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="a36" value="читает" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="Ih12" target="btn"><mxGeometry x="-0.6270" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="151.0"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
