        <mxCell id="sch3" value="&lt;b&gt;Model ID&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1292" y="439" width="64" height="20" as="geometry"/></mxCell>
