        <mxCell id="LL" value="В IDE колонки-номера нет: на строки IDE никто не ссылается по номеру, поэтому при удалении и вставке ничего не пересчитывается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="718" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="sb1_867_8_L0" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="588.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb2_867_9_L1" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4" y="607.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="sb3_867_5_L0" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="27" y="531.5" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="btn" value="У &lt;b&gt;myshop&lt;/b&gt; сменили Model ID 18640 → &lt;b&gt;18650&lt;/b&gt; (ID Manager). &lt;b&gt;mybench&lt;/b&gt; — новая модель, по ошибке Model ID &lt;b&gt;18633&lt;/b&gt; (он у mytree). Выделены обе, нажали &lt;b&gt;Add&lt;/b&gt; в боксе IDE." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="43" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt; — номера шагов стоят у строк слева" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="179" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="206" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="&lt;b&gt;myshop&lt;/b&gt;: ID 18650 в файле нет → строка по имени myshop есть, её ID 18640 = ID из памяти → та же модель, ID сменили → строка перенумеровывается («ID изменён 18640 → 18650»)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="203" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="251" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="&lt;b&gt;LODmyshop&lt;/b&gt; (Model ID 0 → теперь 18650 + 1 = 18651) так же находится по имени и прежнему 18641 и перенумеровывается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="248" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="281" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="&lt;b&gt;mybench&lt;/b&gt;: ID 18633 есть, но в строке имя mytree → &lt;b&gt;конфликт&lt;/b&gt;, mybench не записана: «ID 18633 в файле занят другой моделью «mytree» — «mybench» не записана. Проверь Model ID»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="278" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="326" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="Перед записью — окно «Перед записью найдены проблемы: … Продолжить?». OK → остальное пишется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="323" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="356" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="IPL не меняется: новый ID попадёт в строку IPL при Add в IPL (она найдётся по старому ID из памяти)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="353" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="Mh" value="Память и статусы" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="395" width="750" height="24" as="geometry"/></mxCell>
