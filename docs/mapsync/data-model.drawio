        <mxCell id="pn7_1" value="10" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="697" y="704" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a20" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.2816;entryPerimeter=0;" edge="1" parent="1" source="p7" target="ide"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a21" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5543;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="A" target="p7"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Del&lt;/b&gt; в боксе IDE / 🗑️ — удаляет строку модели и её LOD; пересчитывать нечего" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="782" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="pn8_0" value="11" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d32;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="697" y="774" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a22" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.4658;entryPerimeter=0;" edge="1" parent="1" source="p8" target="ide"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
