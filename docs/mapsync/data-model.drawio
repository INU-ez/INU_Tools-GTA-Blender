        <mxCell id="mdc4_1" value="LODmybarn" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=9;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="116" y="762" width="104" height="18" as="geometry"/></mxCell>
        <mxCell id="mdc4_2" value="mybarn_txd" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=9;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="220" y="762" width="110" height="18" as="geometry"/></mxCell>
        <mxCell id="mdc4_3" value="1500" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=9;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="330" y="762" width="66" height="18" as="geometry"/></mxCell>
        <mxCell id="mdc4_4" value="0" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=9;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="396" y="762" width="46" height="18" as="geometry"/></mxCell>
        <mxCell id="ider" value="Игра: &lt;b&gt;ModelName&lt;/b&gt; → ModelName.dff в IMG; коллизию — по имени модели внутри .col-файлов (аддон пишет её в ModelName.col); &lt;b&gt;TXDName&lt;/b&gt; → TXDName.txd.&lt;br&gt;На строки IDE никто не ссылается по номеру — их можно двигать и удалять без пересчёта. Аддон ищет свою строку по &lt;b&gt;ID&lt;/b&gt; и проверяет &lt;b&gt;имя&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="792" width="520" height="64" as="geometry"/></mxCell>
        <mxCell id="img" value="&lt;b&gt;models/gta3.img&lt;/b&gt; — ФАЙЛЫ моделей: каталог (имя ≤ 23 символов, где лежит, размер) + данные" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="560" height="212" as="geometry"/></mxCell>
        <mxCell id="ie0" value="myhouse.dff" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie1" value="LODmyhouse.dff" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=0;" vertex="1" parent="1"><mxGeometry x="238" y="1070" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie2" value="myhouse.col" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#bdbdbd;rounded=0;" vertex="1" parent="1"><mxGeometry x="416" y="1070" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie3" value="myhouse_txd.txd" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="1094" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie4" value="mytree.dff" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="238" y="1094" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie5" value="mytree_txd.txd" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="416" y="1094" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="ie6" value="mymap_stream0.ipl" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="1118" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="imgr" value="Запись ищется по имени файла. &lt;b&gt;mymap_stream0.ipl&lt;/b&gt; — бинарный IPL внутри архива: игра его читает; «Импорт» аддона его не читает, править его нельзя." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=10;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1148" width="520" height="38" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.0600;entryPerimeter=0;" edge="1" parent="1" source="dat" target="ipl"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="30" y="172"/><mxPoint x="30" y="262"/></Array></mxGeometry></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.0500;entryPerimeter=0;" edge="1" parent="1" source="ipl" target="ide"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="30" y="425"/><mxPoint x="30" y="649"/></Array></mxGeometry></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.0900;entryPerimeter=0;" edge="1" parent="1" source="ide" target="img"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="30" y="820"/><mxPoint x="30" y="1049"/></Array></mxGeometry></mxCell>
        <mxCell id="gch" value="&lt;font style=&quot;font-size:9px&quot;&gt;серые стрелки слева — как читает игра: gta.dat → IPL → (по ID) IDE → (по имени) IMG&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="1244" width="600" height="16" as="geometry"/></mxCell>
        <mxCell id="scn" value="&lt;b&gt;Сцена&lt;/b&gt; — объекты. Имя в файлах: у модели — имя объекта без _DFF и .001; у LOD — его имя из IDE или LOD + имя модели (myhouse_LOD → LODmyhouse)&lt;br&gt;▪ &lt;b&gt;myhouse_DFF&lt;/b&gt; — модель: Model ID, TXD, Draw Dist, LOD Dist, IDE Flags, Interior&lt;br&gt;▪ &lt;b&gt;myhouse_LOD&lt;/b&gt; — её LOD: своей строки IPL не помнит, пишется вместе с моделью; строку IDE помнит&lt;br&gt;▪ &lt;b&gt;myhouse_COL&lt;/b&gt; — коллизия: в IDE и IPL не пишется, только в IMG&lt;br&gt;▪ &lt;b&gt;myhouse_DFF.001&lt;/b&gt; — копия Shift+D: при Add получит свою строку и свой LOD&lt;br&gt;▪ &lt;b&gt;myshop&lt;/b&gt; — новая модель, сделана в Blender" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1320" y="124" width="540" height="176" as="geometry"/></mxCell>
        <mxCell id="wch" value="&lt;b&gt;Наблюдатель&lt;/b&gt; — работает сам: раз в 2 с смотрит время и размер всех IPL / IDE, с которыми связаны модели. Файл изменился → перечитывает и сверяет связи. &lt;b&gt;В файлы не пишет, объекты не двигает.&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1320" y="316" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="mem" value="&lt;b&gt;Память аддона на модели&lt;/b&gt; (скрытые поля объекта, видны как статусы в боксе модели)&lt;br&gt;▪ &lt;b&gt;IPL&lt;/b&gt;: файл, ID, имя, позиция, поворот — как записал или прочитал в прошлый раз; номер LOD-строки; «владелец» — имя объекта (отличает оригинал от копии)&lt;br&gt;▪ &lt;b&gt;IDE&lt;/b&gt;: файл, ID, имя, DrawDist, TXD, Flags — снимок строки&lt;br&gt;▪ &lt;b&gt;IMG&lt;/b&gt;: архив, в котором нашлась модель&lt;br&gt;По этой памяти аддон находит строку снова и показывает «В IPL / координаты разошлись / Не в IPL»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1320" y="442" width="540" height="196" as="geometry"/></mxCell>
        <mxCell id="pan" value="&lt;b&gt;Кнопки&lt;/b&gt;&lt;br&gt;▪ вкладка &lt;b&gt;Импорт&lt;/b&gt;: [Импорт] · 🔄 «Найти IDE» · 🔄 «Найти IMG»&lt;br&gt;▪ вкладка &lt;b&gt;Экспорт&lt;/b&gt;, бокс &lt;b&gt;IDE&lt;/b&gt;: [Add] [Del] [Export]&lt;br&gt;▪ бокс &lt;b&gt;IPL&lt;/b&gt;: [Add] [Del] [Export]&lt;br&gt;▪ бокс модели: строка IDE [▶] [Add] [🗑️] · строка IPL [▶] [Add] [🗑️] · строка IMG [🔄] [Export] [🗑️] · у имени [Check] [🗑️]&lt;br&gt;▪ «IPL для экспорта» 🔄 · «IDE для экспорта» 🔄&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Add в боксе пишет в файл, выбранный в боксе; Add / 🗑️ в строке модели — в «свой» файл модели.&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1320" y="654" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;b&gt;Главные правила записи&lt;/b&gt;&lt;br&gt;▪ Строки, которые аддон не трогает, остаются &lt;b&gt;байт в байт&lt;/b&gt; (комментарии, вид чисел, другие секции).&lt;br&gt;▪ Новые строки встают перед &lt;b&gt;end&lt;/b&gt; (IPL — последней inst, IDE — последней objs).&lt;br&gt;▪ Файл пишется целиком через временный; при первой записи за сессию рядом — &lt;b&gt;.bak&lt;/b&gt;.&lt;br&gt;▪ Add / Del / 🗑️ в строках — сначала пробный прогон; есть проблемы → окно «Перед записью найдены проблемы … Продолжить?». 🗑️ у имени модели пишет сразу, без окна." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1320" y="920" width="540" height="160" as="geometry"/></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Импорт&lt;/b&gt; — читает IPL, IDE (бокс IDE или все по gta.dat), IMG: ставит модели, запоминает строки" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="530" height="50" as="geometry"/></mxCell>
        <mxCell id="pn0_0" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="697" y="122" width="21" height="21" as="geometry"/></mxCell>
        <mxCell id="a6" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.3229;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="dat" target="p0"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a7" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#1565c0;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#1565c0;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.0603;entryPerimeter=0;" edge="1" parent="1" source="p0" target="A"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Add&lt;/b&gt; в боксе IPL / в строке IPL модели — дописывает или переписывает строку модели и её LOD-строку" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="252" width="530" height="50" as="geometry"/></mxCell>
