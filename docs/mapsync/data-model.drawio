        <mxCell id="I3sz" value="&lt;b&gt;14&lt;/b&gt; сект." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="728" y="750" width="120" height="18" as="geometry"/></mxCell>
        <mxCell id="RL0" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="56" y="870" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt0" value="новая строка" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="867" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RL1" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="164" y="870" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt1" value="строка переписана (жирным — что изменилось)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="186" y="867" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RL2" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="489" y="870" width="18" height="14" as="geometry"/></mxCell>
        <mxCell id="RLt2" value="строка удалена" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="511" y="867" width="260" height="18" as="geometry"/></mxCell>
        <mxCell id="RLu" value="белая — не тронута (байт в байт)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611" y="867" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="btn" value="Выделены &lt;b&gt;myhouse_DFF&lt;/b&gt;, &lt;b&gt;myshop&lt;/b&gt; и &lt;b&gt;LODmyshop&lt;/b&gt;. &lt;b&gt;Export&lt;/b&gt; в строке IMG → в окне: архив gta3.img, TXD myhouse_txd и myshop_txd. Потом 🔄 в строке IMG (myshop станет «В IMG») и 🗑️ при выделенных myshop и LODmyshop. Потом ещё раз Export с галочкой «Пересобрать после экспорта»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="122" width="880" height="43" as="geometry"/></mxCell>
        <mxCell id="sh" value="&lt;b&gt;Что делает аддон&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="179" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="st1" value="1" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="206" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt1" value="Имена записей: &lt;b&gt;модель.dff&lt;/b&gt;, LOD — под своим именем из IDE (у своих моделей &lt;b&gt;LODмодель.dff&lt;/b&gt;), &lt;b&gt;модель.col&lt;/b&gt; и &lt;b&gt;TXD.txd&lt;/b&gt;; «модель» — имя объекта без _DFF / _LOD / _COL и .001, то же, что ModelName в IDE / IPL. Имя длиннее 23 символов — весь экспорт отменяется." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="203" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st2" value="2" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="251" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt2" value="LOD и коллизию окно ищет по имени объекта (модель_LOD, модель_COL) или среди выделенных; поле «LOD partner» не смотрит. myhouse_LOD и коллизии нашлись по имени, LODmyshop — потому что выделен." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="248" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st3" value="3" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="296" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt3" value="Запись есть и новые данные &lt;b&gt;влезают&lt;/b&gt; в её место → пишутся на месте: myhouse.dff (3 → 2 сектора, хвост — мёртвый), LODmyhouse.dff, myhouse.col." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="293" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st4" value="4" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="326" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt4" value="&lt;b&gt;Не влезает&lt;/b&gt; → данные дописываются в конец, запись каталога перенаправляется, старое место становится мёртвым: myhouse_txd.txd (4 → 6 секторов)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="323" width="850" height="26" as="geometry"/></mxCell>
        <mxCell id="st5" value="5" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="356" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt5" value="&lt;b&gt;Новое имя&lt;/b&gt; → новая запись каталога + данные в конец: LODmyshop.dff, myshop.dff, myshop.col, myshop_txd.txd. Каталог записывается один раз в конце; если он налез на данные первых файлов — они переносятся в конец." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="353" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st6" value="6" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="401" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt6" value="Имя TXD из окна записывается в поле TXD выделенных моделей (и LOD, если выделен). Отличается от строки IDE — статус «В IDE, изменено: TXD», пока не нажать Add в IDE. Статус «В IMG» экспорт не меняет: у myshop «Не в IMG», и 🗑️ серая, пока не нажать 🔄." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="398" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st7" value="7" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="446" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt7" value="&lt;b&gt;🗑️&lt;/b&gt;: у модели удаляются модель.dff и &lt;b&gt;модель.txd&lt;/b&gt; — myshop.dff удалён, а myshop.txd такого нет: настоящий TXD myshop_txd.txd остался. У LOD — его .dff. Удаляется только запись каталога, данные остаются мёртвым местом." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="443" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="st8" value="8" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1565c0;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1000" y="491" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="stt8" value="&lt;b&gt;Пересборка&lt;/b&gt;: отдельной кнопки в панели нет — галочка «Пересобрать после экспорта» в окне Export (по умолчанию выключена). После записи живые записи переписываются подряд во временный архив, он подменяет старый: 22 → 14 секторов." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1a1a1a;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="488" width="850" height="41" as="geometry"/></mxCell>
        <mxCell id="iw" value="&lt;b&gt;Галочки LOD и COL в окне стоят по умолчанию.&lt;/b&gt; Не нашлись LOD или коллизия (не выделены и названы не модель_LOD / модель_COL — например LOD с приставкой, LODmyshop) — в архив уходит заглушка: копия модели вместо LOD и пустая коллизия по габаритам, и она &lt;b&gt;заменяет настоящую запись&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="543" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="n0" value="Строки IDE и IPL Export в IMG не создаёт — новой модели нужны ещё Add в IDE и Add в IPL." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="592" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="n1" value="Пока нет пересборки, игра всё равно найдёт нужное: она берёт запись по каталогу. Мёртвое место только раздувает архив. (Сообщение аддона «иначе игра подтянет старую запись» — неточное.)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="624" width="880" height="41" as="geometry"/></mxCell>
        <mxCell id="n2" value="SA — один .img (каталог внутри), III / VC — .img + .dir рядом. Запись в архив идёт на месте, не через временный файл (в отличие от IDE / IPL)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="671" width="880" height="26" as="geometry"/></mxCell>
        <mxCell id="a91" value="читает / пишет" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#2e7d32;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;startArrow=block;startFill=1;startSize=6;" edge="1" parent="1" source="I0sz" target="btn"><mxGeometry x="-0.6085" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/><Array as="points"><mxPoint x="930" y="183"/><mxPoint x="930" y="140"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p14" name="13 Что если…">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;13. Что если… — опасные случаи, найденные прогоном настоящего кода&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Каждая карточка — ситуация, в которой аддон портит файл, теряет связь или ставит модель дважды. Проверено запуском кода аддона на тестовых файлах (dev/diagrams/probes). Полные каталоги — со всеми «нормально» и «неожиданно», причиной в коде и идеей исправления — в dev/diagrams/facts/scenarios_*.md." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="ipl_addh" value="&lt;b&gt;IPL: Add&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;опасно &lt;b&gt;34&lt;/b&gt; · неожиданно 10 · нормально 27 — scenarios_ipl_add.md&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="450" height="46" as="geometry"/></mxCell>
        <mxCell id="ipl_addc0" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;1a 1a2 1f&lt;/font&gt;&amp;nbsp; Колонку LOD испортили в Блокноте (удалили, вставили или отсортировали строки) → Add &lt;b&gt;перезаписывает чужую строку&lt;/b&gt; своим LOD, старая LOD-строка остаётся точным дублем." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="450" height="59" as="geometry"/></mxCell>
        <mxCell id="ipl_addc1" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;1b–1e 6b&lt;/font&gt;&amp;nbsp; Номер LOD указывает на строку соседа, на чужую LOD, за конец файла или на саму модель → дописывается новая LOD, старая остаётся &lt;b&gt;сиротой-дублем&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="207" width="450" height="59" as="geometry"/></mxCell>
        <mxCell id="ipl_addc2" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;3b&lt;/font&gt;&amp;nbsp; LOD одной модели — строка другой модели, обе в одном Add → результат &lt;b&gt;зависит от порядка выделения&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="274" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;5b&lt;/font&gt;&amp;nbsp; У inst в конце файла нет end → новые строки встают &lt;b&gt;в начало файла&lt;/b&gt;, LOD у всех моделей съезжает." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="327" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc4" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;5c 5d&lt;/font&gt;&amp;nbsp; «end # комментарий» / «inst # комментарий» не распознаются → строки пишутся &lt;b&gt;внутрь cull&lt;/b&gt; или новым inst в начало." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc5" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;6a&lt;/font&gt;&amp;nbsp; Мусорная строка внутри inst: Add считает её в нумерации, импорт — нет → после записи &lt;b&gt;LOD не те&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="433" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;7d&lt;/font&gt;&amp;nbsp; Комментарий в конце своей строки → строка не читается → связь снята → &lt;b&gt;точный дубль&lt;/b&gt; (или комментарий стирается)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="486" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;24 25&lt;/font&gt;&amp;nbsp; Строка из 13–14 колонок (SA + FLA + лишняя) → переписывается &lt;b&gt;в чужом формате&lt;/b&gt; или теряет FLA." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="539" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;11b 12b 16b 16c 17c 23&lt;/font&gt;&amp;nbsp; Add не нашёл «свою» строку (сдвинули дальше 2 м, сменили ID в файле, модель стоит на ванильной строке, Shift+D и Esc, проект в другой папке) → &lt;b&gt;точный дубль&lt;/b&gt; модели и LOD (краш SA)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="450" height="59" as="geometry"/></mxCell>
        <mxCell id="ipl_addc9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;11c 11d 17d&lt;/font&gt;&amp;nbsp; Поиск «в 2 м» забирает &lt;b&gt;ванильную или соседскую&lt;/b&gt; строку той же модели и переписывает её." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="659" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;2 18e&lt;/font&gt;&amp;nbsp; Общий LOD двух моделей или LOD не в точке модели → Add без изменений &lt;b&gt;раздваивает или переносит&lt;/b&gt; ванильный LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="712" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc11" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;18d&lt;/font&gt;&amp;nbsp; LOD не найден (Skip LOD, имя в IDE не по модели), модель сдвинули → LOD &lt;b&gt;остаётся на старом месте&lt;/b&gt;, молча." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="765" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;18c&lt;/font&gt;&amp;nbsp; LOD с ID 0 → ID модели + 1, а он в IDE &lt;b&gt;занят другой моделью&lt;/b&gt; → игра ставит её вместо LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="818" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_addc13" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;10g&lt;/font&gt;&amp;nbsp; VC: ванильная LOD дальше 0,5 м от модели → &lt;b&gt;вторая LOD&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="871" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="ipl_addc14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;9b&lt;/font&gt;&amp;nbsp; Interior 13 (FLA) у строки без 12-й колонки &lt;b&gt;молча теряется&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="909" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="ipl_addc15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;10c 10d 10e&lt;/font&gt;&amp;nbsp; Игра сцены не совпадает с форматом файла → строки &lt;b&gt;чужого формата&lt;/b&gt;; у VC / III масштаб сбрасывается в 1." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="947" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmh" value="&lt;b&gt;IPL: Del, наблюдатель, 🔄 / ▶ / Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;опасно &lt;b&gt;11&lt;/b&gt; · неожиданно 24 · нормально 19 — scenarios_ipl_remove_watch.md&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="84" width="450" height="46" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc0" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;D2b&lt;/font&gt;&amp;nbsp; Del модели удаляет и &lt;b&gt;чужую строку&lt;/b&gt;, если колонка LOD модели указывает на строку другой связанной модели (без «lod» в имени) — у соседа связь снимается." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="140" width="450" height="59" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc1" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;D4a&lt;/font&gt;&amp;nbsp; Del несвязанной модели удаляет &lt;b&gt;ванильную строку&lt;/b&gt; той же модели в пределах 0,5 м — поворот не сверяется, окна нет." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="207" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc2" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;L2&lt;/font&gt;&amp;nbsp; После Del полный &lt;b&gt;Export IPL&lt;/b&gt; берёт старый номер LOD из памяти: в новом файле LOD дома указывает на скамейку." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="260" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;W3&lt;/font&gt;&amp;nbsp; Строку в MEd сдвинули дальше 2 м → связь снята → Add молча дописывает &lt;b&gt;вторую пару&lt;/b&gt; модель + LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="313" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc4" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;W10&lt;/font&gt;&amp;nbsp; Вставили строку руками и не поправили колонку LOD → Del удаляет &lt;b&gt;чужую строку&lt;/b&gt;, Add переписывает её в LOD." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="366" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc5" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;W17&lt;/font&gt;&amp;nbsp; Наблюдатель раздаёт строки «кто первый»: после ручной правки модель забирает строку соседа, Add &lt;b&gt;затирает соседа&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="419" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;W19&lt;/font&gt;&amp;nbsp; Карту импортировали дважды → наблюдатель перешивает копию на соседнюю строку → Add ставит &lt;b&gt;две модели в одну точку&lt;/b&gt; (краш SA)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="472" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;P2&lt;/font&gt;&amp;nbsp; Check привязывает к единственной ванильной строке модели &lt;b&gt;за 3 км&lt;/b&gt; → Add переносит ванильный объект." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="525" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;P3b&lt;/font&gt;&amp;nbsp; Add, потом Ctrl+Z (файл не откатывается), потом Check → модель забирает строку соседа → в игре она &lt;b&gt;дважды&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="578" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;P3c&lt;/font&gt;&amp;nbsp; То же с 🔄 → строка-&lt;b&gt;дубль в одной точке&lt;/b&gt; (краш SA)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="631" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="ipl_rmc10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;P5c&lt;/font&gt;&amp;nbsp; В папке игры лежит &lt;b&gt;backup\city.ipl&lt;/b&gt; → 🔄 связывает с бэкапом → Add пишет дубль в настоящий city.ipl." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="484" y="669" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="ideh" value="&lt;b&gt;IDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;опасно &lt;b&gt;13&lt;/b&gt; · неожиданно 21 · нормально 32 — scenarios_ide.md&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="84" width="450" height="46" as="geometry"/></mxCell>
        <mxCell id="idec0" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;A8b&lt;/font&gt;&amp;nbsp; Копии Shift+D сменили только Model ID → Add &lt;b&gt;перенумеровывает строку оригинала&lt;/b&gt;: ID оригинала пропадает из IDE, его строки IPL остаются без определения." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="140" width="450" height="59" as="geometry"/></mxCell>
        <mxCell id="idec1" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;Y2&lt;/font&gt;&amp;nbsp; ▶ / 🔄 Sync IDE нашёл по ID &lt;b&gt;чужую ванильную строку&lt;/b&gt; → перетянул её TXD, дальность, флаги; следующий Add переименовывает ванильную строку." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="207" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec2" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;Y1&lt;/font&gt;&amp;nbsp; Одно имя в двух IDE → Sync берёт первый по gta.dat: Model ID меняется на ванильный, связь уезжает в ванильный файл." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="260" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;L4&lt;/font&gt;&amp;nbsp; Имя LOD в IDE без «lod» (house_far) → Add переименовывает строку в &lt;b&gt;LODhouse_far&lt;/b&gt;, а в IMG лежит house_far.dff." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="313" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec4" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;A7&lt;/font&gt;&amp;nbsp; Объект переименовали в имя, которое уже есть под другим ID → в файле &lt;b&gt;два одинаковых имени&lt;/b&gt;, без сообщений." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="366" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec5" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;X1&lt;/font&gt;&amp;nbsp; Объект из VC-IDE в SA-сцене: новый SA-флаг (дерево и т. п.) &lt;b&gt;не записывается&lt;/b&gt;, статус навсегда «изменено: Flags»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="419" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;X2&lt;/font&gt;&amp;nbsp; Sync из SA-файла у объекта, пришедшего из VC → первый Add &lt;b&gt;стирает флаги&lt;/b&gt; строки." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="472" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;X3&lt;/font&gt;&amp;nbsp; Import IDE принимает SA-файл за VC (есть txdp, нет 2dfx) → Add &lt;b&gt;стирает SA-флаги&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="525" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;G2&lt;/font&gt;&amp;nbsp; SA-сцена пишет в VC / III-файл: «1, 299, 0» → «299, 0», а VC / III читают это число как &lt;b&gt;количество мешей&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="578" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;N2&lt;/font&gt;&amp;nbsp; Пробел или запятая в имени → строка пишется &lt;b&gt;битой&lt;/b&gt;; следующий Add — конфликт сам с собой." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="631" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;N3&lt;/font&gt;&amp;nbsp; Имя или TXD длиннее 23 символов пишется без проверки — ошибка «Игра не примет» только &lt;b&gt;после&lt;/b&gt; записи." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="684" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec11" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S7&lt;/font&gt;&amp;nbsp; «end # комментарий» / «objs # комментарий» не распознаются → новая строка &lt;b&gt;вне секции&lt;/b&gt; или дубль." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="737" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="idec12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;A5&lt;/font&gt;&amp;nbsp; ID уже занят в &lt;b&gt;другом IDE игры&lt;/b&gt; → пишется без предупреждения (проверяется только выбранный файл)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="948" y="790" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgh" value="&lt;b&gt;IMG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;опасно &lt;b&gt;10&lt;/b&gt; · неожиданно 19 · нормально 14 — scenarios_img.md&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="84" width="450" height="46" as="geometry"/></mxCell>
        <mxCell id="imgc0" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;E01&lt;/font&gt;&amp;nbsp; Галочки LOD / COL в окне Export стоят по умолчанию: нет LOD / коллизии в сцене → &lt;b&gt;заглушки заменяют&lt;/b&gt; настоящие LOD и коллизию в архиве." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="140" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc1" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;E02&lt;/font&gt;&amp;nbsp; Общий TXD собирается &lt;b&gt;только из выделенных&lt;/b&gt; → у других моделей и LOD пропадают текстуры." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="193" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc2" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;E03&lt;/font&gt;&amp;nbsp; 🗑️ на модели удаляет «модель.txd», не глядя на поле TXD → удаляется &lt;b&gt;TXD чужой модели&lt;/b&gt;, свой остаётся." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="246" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;E04&lt;/font&gt;&amp;nbsp; Одно имя в нескольких .img (бэкап) → импорт и Export работают с &lt;b&gt;бэкапом&lt;/b&gt;, а игра грузит gta3.img." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="299" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc4" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S15&lt;/font&gt;&amp;nbsp; В архиве две записи с одним именем → Export правит &lt;b&gt;вторую&lt;/b&gt;, игра грузит первую; отчёт «replaced»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="352" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc5" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S16&lt;/font&gt;&amp;nbsp; Пересборка архива с дублями оставляет данные второй записи и &lt;b&gt;удаляет первую&lt;/b&gt;, которую грузила игра." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="405" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S12&lt;/font&gt;&amp;nbsp; SA-архив при сцене VC / III → Export пишет рядом &lt;b&gt;.dir&lt;/b&gt;, игра новых данных не видит; отчёт «added»." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="458" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;E05&lt;/font&gt;&amp;nbsp; LOD импортирован без IDE → Export пишет &lt;b&gt;LODимя.dff&lt;/b&gt;, а IDE / IPL ждут настоящее имя (tatar_str_1LOD.dff)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="511" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S19&lt;/font&gt;&amp;nbsp; В архиве запись с русским именем → любой Export или 🗑️ &lt;b&gt;переименовывает её в ???.dff&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="564" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="imgc9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#757575&quot;&gt;S07&lt;/font&gt;&amp;nbsp; (из панели не достать) больше ~130 пустых файлов за раз → каталог затирает первый файл архива." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1412" y="617" width="450" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p15" name="Add в IPL">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Нажали «Add» в боксе IPL — что делает аддон&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Для каждой выделенной модели идём сверху вниз: на каждый вопрос — &lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt; или &lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="s" value="&lt;b&gt;Нажали «Add»&lt;/b&gt; — берём выделенную модель" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="q1" value="Это &lt;b&gt;копия&lt;/b&gt; (Shift+D)?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b1" value="Отвязать от оригинала —&lt;br&gt;копия пойдёт как новая строка" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="175" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="q2" value="Модель уже &lt;b&gt;связана&lt;/b&gt; с IPL?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Добавить новую строку&lt;/b&gt;&lt;br&gt;в файл из бокса IPL&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;даже если такая уже есть — будет дубль&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="292" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="q3" value="В боксе выбран&lt;br&gt;&lt;b&gt;другой&lt;/b&gt; файл?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Новая строка&lt;/b&gt; в выбранном файле.&lt;br&gt;⚠ старая строка в прежнем остаётся" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="415" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="q4" value="Строка на &lt;b&gt;запомненном месте&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ID и позиция как при прошлой&lt;br&gt;записи, точность 1 см&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Обновить эту строку&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;сменили Model ID — строка получит новый&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="540" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="q5" value="В радиусе &lt;b&gt;2 м&lt;/b&gt; от запомненного&lt;br&gt;места есть свободная строка&lt;br&gt;с тем же ID?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;обычно — строку двигали руками&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Обновить её&lt;/b&gt; — «строка была изменена&lt;br&gt;вручную — найдена рядом»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="675" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;Добавить заново&lt;/b&gt; — «прежняя строка&lt;br&gt;не найдена»" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="m" value="Строка модели готова → &lt;b&gt;теперь LOD&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="a92" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="s" target="q1"><mxGeometry x="0.1667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a93" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="q1" target="b1"><mxGeometry x="-0.4500" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a94" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a95" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry x="-0.5088" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a96" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="q2" target="b2"><mxGeometry x="-0.4500" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a97" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a98" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;да&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="q3" target="b3"><mxGeometry x="-0.4500" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a99" value="&lt;b&gt;&lt;font color=&quot;#c62828&quot;&gt;нет&lt;/font&gt;&lt;/b&gt;" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#757575;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;labelBorderColor=#757575;spacing=3;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="q3" target="q4"><mxGeometry x="-0.0667" relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell>
