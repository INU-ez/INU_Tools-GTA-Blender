  <diagram id="p13" name="12 IMG: Export, 🗑️, пересборка">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;12. IMG: Export кладёт файлы в архив, 🗑️ убирает из каталога, пересборка сжимает&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Архив = каталог (имя записи, где лежит, сколько секторов по 2048 байт) + данные. Числа ниже — прогон настоящего кода аддона на тестовом архиве." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=12;fontColor=#1a1a1a;fillColor=#fafafa;strokeColor=#bdbdbd;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="58" as="geometry"/></mxCell>
        <mxCell id="gh" value="🎮 &lt;b&gt;ИГРА&lt;/b&gt; — архив &lt;b&gt;models/gta3.img&lt;/b&gt; (SA, VER2: каталог внутри архива)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="ah" value="🧩 &lt;b&gt;АДДОН&lt;/b&gt; — Blender" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=13;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="880" height="30" as="geometry"/></mxCell>
